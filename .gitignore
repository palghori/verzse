# ============================================================
# VERZSE — .gitignore
# ============================================================

# --- AI Model Files (TOO LARGE for GitHub — 100 MB limit) ---
# Users must download their own .gguf model file.
# Place it inside models/ after cloning.
models/*.gguf
models/*.bin
*.gguf
*.bin

# --- llama.cpp (Users clone & compile this themselves) ---
llama.cpp/

# --- Python Virtual Environment ---
venv/
env/
.venv/
.env/

# --- PyInstaller Build Artifacts ---
build/
dist/
*.spec
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# --- Logs ---
*.log
*.log.*
backend.log
llama_cpp.log

# --- Environment / Secrets / Sensitive Data ---
.env
.env.local
.env.production
.env.*.local
*.key
*.pem
*.token

# --- macOS System Files ---
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# --- Editor & IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Node (if ever added) ---
node_modules/

# --- Temporary files & Backups ---
*.tmp
*.temp
.cache/
*.bak
.git_original_bloated_backup/
llama ai
